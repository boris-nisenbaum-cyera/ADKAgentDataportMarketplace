# Copy to .env for local runs -- never commit real values.

# --- Cyera Dataport MCP connection (required) ---
# Same as ../ADKAgentDataport/.env.example -- see that file's comments for
# how to obtain/verify this token. Unchanged by the Marketplace
# repackaging: this agent still calls the same already-hosted Cyera
# Dataport MCP gateway.
CYERA_DATAPORT_MCP_TOKEN=

# Override only if Cyera's gateway moves again. Verified live to be the
# working Streamable HTTP endpoint as of this writing.
# CYERA_DATAPORT_MCP_URL=https://mcp.cyera.io/public/dataport/mcp

# --- Model credentials (required, choose ONE) ---
# Option A: AI Studio API key (Gemini models only)
# GOOGLE_API_KEY=

# Option B: Vertex AI (required for the default model)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=boris-scc-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Model selection (optional) ---
# Defaults to "gemini-2.5-pro". Set to any other ADK-resolvable model
# string to override, e.g.:
# ADK_MODEL=gemini-2.5-pro
# ADK_MODEL=claude-sonnet-5
# ADK_MODEL=gemini-2.5-flash

# Gemini reasoning depth in tokens (ignored for non-Gemini ADK_MODEL
# values). -1 = AUTOMATIC (model chooses, maximum depth), 0 = disabled,
# positive int = manual token budget.
# THINKING_BUDGET=-1

# --- Inbound caller auth (optional -- see oauth_middleware.py) ---
# The OAuth2/OIDC provider that issues the end-user access tokens Gemini
# Enterprise presents to this agent. Defaults to Cyera's own real,
# live-confirmed OIDC provider -- only override if this is ever deployed
# against a different Cyera environment/tenant.
# OIDC_ISSUER=https://oidc.cyera.io
# OIDC_JWKS_URI=https://oidc.cyera.io/oidc/jwks

# The `aud` claim this agent's tokens must carry. Left unset by default
# (no audience check) until real Marketplace OAuth client registrations
# exist -- see dcr/main.py and this directory's README.md.
# OAUTH_AUDIENCE=

# --- A2A public agent card (optional -- see main.py's module docstring) ---
# Leave unset for local runs (defaults to localhost/8080/http). After the
# first Cloud Run deploy, set these to the real service URL and redeploy:
# A2A_HOST=cyera-dataport-agent-marketplace-<hash>-uc.a.run.app
# A2A_PORT=443
# A2A_PROTOCOL=https

# The separately-deployed DCR/marketplace-procurement handler's own public
# URL (see ../dcr/). Set once that service is deployed.
# DCR_TARGET_URL=https://cyera-dataport-dcr-<hash>-uc.a.run.app/dcr

# --- Local server port (optional) ---
# PORT=8080
