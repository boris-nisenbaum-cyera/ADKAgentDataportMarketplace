# Copy to .env for local runs -- never commit real values.

# --- Google Marketplace DCR JWT verification (optional but recommended) ---
# This service's own public URL, matching exactly what the Agent Card's
# DCR extension target_url advertises (the `aud` on Google's
# software_statement JWTs). Leave unset only for early local testing --
# id_token.verify_token() then skips the audience check entirely, which
# must NOT be the case in production.
DCR_PROVIDER_URL=

# --- Cyera OIDC provider (optional -- defaults are already correct) ---
# Verified live to be Cyera's own real RFC 7591 registration endpoint
# (see utils.py's module docstring). Only override for a different
# Cyera environment/tenant.
# OIDC_REGISTRATION_ENDPOINT=https://oidc.cyera.io/oidc/reg

# --- Gemini Enterprise OAuth redirect (required before real use) ---
# The redirect_uri Gemini Enterprise's OAuth authorization-code callback
# uses -- obtained from the Marketplace Producer Portal once this listing
# actually exists (see ../README.md). Registration will otherwise
# succeed with an empty redirect_uris list, which no real OAuth flow can
# use.
GEMINI_ENTERPRISE_REDIRECT_URI=

# --- Local server port (optional) ---
# PORT=8081
